-- Reaplica ESP automaticamente se alguém trocar de time
local function conectarTrocaTime(p)
    p:GetPropertyChangedSignal("Team"):Connect(function()
        if not espAtivo then return end
        if mesmoTime(p) then
            -- Virou do meu time: remove ESP
            if highlights[p] then highlights[p]:Destroy(); highlights[p] = nil end
            if linhas[p] then linhas[p]:Remove(); linhas[p] = nil end
        else
            -- Não é mais do meu time: reaplica ESP
            aplicarESP(p)
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do conectarTrocaTime(p) end
Players.PlayerAdded:Connect(conectarTrocaTime)

RunService.RenderStepped:Connect(function()
    if not espAtivo then return end
    local centro = Camera.ViewportSize / 2
    local origem = Vector2.new(centro.X, Camera.ViewportSize.Y)

    for player, linha in pairs(linhas) do
        if linha then
            local char = player.Character
            local head = char and char:FindFirstChild("Head")
            if head then
                local posTela, naTela = Camera:WorldToViewportPoint(head.Position)
