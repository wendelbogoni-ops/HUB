local function atualizarHitboxes()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local tamanhoReal = 4 + ((hitboxTamanho / 100) * 16)

                if hitboxAtiva then
                    if not originaisHRP[player] then
                        originaisHRP[player] = {
                            Size = hrp.Size,
                            Transparency = hrp.Transparency,
                            CanCollide = hrp.CanCollide
                        }
                    end

                    hrp.Size = Vector3.new(tamanhoReal, tamanhoReal, tamanhoReal)
                    hrp.Transparency = 0.6
                    hrp.CanCollide = false

                    if not adornments[player] then
                        local box = Instance.new("BoxHandleAdornment")
                        box.Adornee = hrp
                        box.AlwaysOnTop = true
                        box.ZIndex = 10
                        box.Size = hrp.Size
                        box.Color3 = Color3.fromRGB(0, 170, 255)
                        box.Transparency = 0.5
                        box.Parent = hrp
                        adornments[player] = box
                    else
                        adornments[player].Size = hrp.Size
                    end
                else
                    if originaisHRP[player] then
                        hrp.Size = originaisHRP[player].Size
                        hrp.Transparency = originaisHRP[player].Transparency
                        hrp.CanCollide = originaisHRP[player].CanCollide
                        originaisHRP[player] = nil
                    end
                    if adornments[player] then
                        adornments[player]:Destroy()
                        adornments[player] = nil
                    end
                end
            end
        end
    end
end

