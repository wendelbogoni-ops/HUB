local function criarLinha()
    local ok, linha = pcall(function()
        local l = Drawing.new("Line")
        l.Thickness = 1
        l.Color = COR_ROXO
        l.Transparency = 1
        l.Visible = false
        return l
    end)
    if ok then return linha end
    return nil
end

local function aplicarESP(player)
    if player == LocalPlayer then return end
    -- Se for do mesmo time e toggle ligado, não aplica
    if mesmoTime(player) then return end

    local char = player.Character
    if not char then return end

    if highlights[player] then highlights[player]:Destroy() end
    local hl = Instance.new("Highlight")
    hl.FillColor = COR_ROXO
    hl.OutlineColor = COR_ROXO
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    highlights[player] = hl

    if not linhas[player] then
        linhas[player] = criarLinha()
    end
end

local function limparTodoESP()
    for _, h in pairs(highlights) do if h then h:Destroy() end end
    for _, l in pairs(linhas) do if l then l:Remove() end end
    highlights = {}
    linhas = {}
end

