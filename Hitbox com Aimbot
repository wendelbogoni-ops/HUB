LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    atualizarFiltroRaycast()
end)

-- Verifica se há linha de visão livre da câmera até a cabeça do alvo
local function temLinhaDeVisao(head)
    if not head or not head.Parent then return false end
    local char = head.Parent

    local origem  = Camera.CFrame.Position
    local direcao = head.Position - origem

    local resultado = Workspace:Raycast(origem, direcao, rayParams)
    if not resultado then
        return true
    end
    if resultado.Instance and resultado.Instance:IsDescendantOf(char) then
        return true
    end
    return false
end

-- Verifica se o jogador é do mesmo time que o LocalPlayer
local function mesmoTime(player)
    if not ignorarTime then return false end
    if player == LocalPlayer then return true end
    if not LocalPlayer.Team or not player.Team then return false end
    return player.Team == LocalPlayer.Team
end

