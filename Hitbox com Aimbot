rayParams.IgnoreWater = true

local function atualizarFiltroRaycast()
    local filtro = {}
    if LocalPlayer.Character then
        table.insert(filtro, LocalPlayer.Character)
    end
    rayParams.FilterDescendantsInstances = filtro
end

