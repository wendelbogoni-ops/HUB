-- 5) LÓGICA AIMBOT (COM WALL CHECK + TEAM CHECK)
-- ============================================================
local function pegarAlvo()
    local centro = Camera.ViewportSize / 2
    local melhorAlvo, melhorDist = nil, FOV_AIMBOT

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not mesmoTime(player) and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                local posTela, naTela = Camera:WorldToViewportPoint(head.Position)
                if naTela then
                    local dist = (Vector2.new(posTela.X, posTela.Y) - centro).Magnitude
                    if dist < melhorDist and temLinhaDeVisao(head) then
                        melhorDist = dist
                        melhorAlvo = head
                    end
                end
            end
        end
    end
    return melhorAlvo
end

