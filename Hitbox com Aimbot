-- ============================================================
-- 8) ARRASTAR O PAINEL
-- ============================================================
local arrastando = false
local offset = nil

logo.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = true
        offset = Vector2.new(input.Position.X, input.Position.Y) - Vector2.new(main.AbsolutePosition.X, main.AbsolutePosition.Y)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if arrastando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local novaPos = Vector2.new(input.Position.X, input.Position.Y) - offset
        main.Position = UDim2.new(0, novaPos.X, 0, novaPos.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = false
    end
end)
